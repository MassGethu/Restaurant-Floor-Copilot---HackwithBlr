# Serves the built dashboard and the backend API on one local address for
# share_online.sh. Cloudflare Tunnel points at this. There is no login:
# anyone with the (random, temporary) link can use the app.
{
	admin off
	auto_https off
}

:{$SHARE_PORT:8090} {
	# API, live MJPEG stream and WebSockets go to the backend unbuffered.
	@backend path /api/* /ws/*
	handle @backend {
		reverse_proxy 127.0.0.1:{$API_PORT:8001} {
			flush_interval -1
		}
	}

	# Everything else is the React app; unknown paths fall back to index.html.
	handle {
		root * {$DIST_DIR}
		try_files {path} /index.html
		file_server
	}
}
